{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://example.invalid/daat/mapping-profile/0.2.0-draft",
 "title":"DaaT local mapping manifest (DRAFT, non-IK)",
 "type":"object","additionalProperties":false,
 "required":["format","id","version","source_contract","target_contract","rules","field_policy","capabilities"],
 "properties":{
  "format":{"const":"daat.mapping-profile/0.2.0-draft"},
  "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{2,79}$"},
  "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "capabilities":{"type":"array","items":{"type":"string","minLength":2},"minItems":1,"uniqueItems":true},
  "source_contract":{"$ref":"#/$defs/contract"},"target_contract":{"$ref":"#/$defs/contract"},
  "field_policy":{"type":"object","additionalProperties":false,"required":["must_preserve","exclusions","required_target_obligations"],"properties":{
    "must_preserve":{"type":"array","items":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},"uniqueItems":true},
    "exclusions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","reason","approved_by"],"properties":{"path":{"type":"string","minLength":1},"reason":{"type":"string","minLength":5},"approved_by":{"type":"string","minLength":3}}}},
    "required_target_obligations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }},
  "rules":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["op","from","to","class","obligation"],"properties":{
   "op":{"enum":["copy","rename","map_enum","convert_unit","assert_equal"]},
   "from":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
   "to":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
   "class":{"enum":["identity","alias","structural","value","contextual"]},
   "obligation":{"type":"string","minLength":1},
   "map":{"type":"object","additionalProperties":{"type":"string"},"minProperties":1},
   "factor":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)?$"},
   "equals":{"type":["string","integer","boolean","null"]}
  }}},
  "golden_input":{"type":"string"},"golden_expected":{"type":"string"}
 },
 "$defs":{"contract":{"type":"object","additionalProperties":false,"required":["ref","path","sha256"],"properties":{"ref":{"type":"string","minLength":3},"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
}
