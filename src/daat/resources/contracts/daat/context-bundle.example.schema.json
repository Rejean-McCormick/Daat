{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/daat/docs/context-bundle.example.schema.json",
  "title": "DaaT Context Bundle — illustrative local draft (NOT IK, NOT Kristal)",
  "description": "Design artifact only. No adoption or remote authority. Source bytes must be shareable before inclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "scope",
    "sources",
    "fragments",
    "uncertainties",
    "disclosure",
    "prompts",
    "validation"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "format_label",
        "generated_at",
        "version"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "format_label": {
          "const": "daat.context-bundle.local-example/0.1-proposed"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "language"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "platform_profile_id",
          "external_id",
          "revision",
          "content_kind",
          "rights",
          "checked_at"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "platform_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "content_kind": {
            "enum": [
              "reference_only",
              "abstract",
              "excerpt",
              "full_text_authorized",
              "dataset",
              "structured_record",
              "media_derivative"
            ]
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read",
              "copy",
              "retain",
              "transform",
              "ai_disclosure"
            ],
            "properties": {
              "read": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "copy": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "retain": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "transform": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "ai_disclosure": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              }
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "rights_evidence_ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "acquired_via": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "rights_attestation": {
            "enum": [
              "unverified",
              "operator_asserted",
              "host_verified"
            ]
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "rights_expiry": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id",
          "source_ref",
          "source_revision",
          "text",
          "locator",
          "content_kind",
          "quote_verified",
          "share_allowed",
          "sha256"
        ],
        "properties": {
          "fragment_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "content_kind": {
            "enum": [
              "abstract",
              "excerpt",
              "full_text_authorized",
              "dataset",
              "structured_record",
              "media_derivative"
            ]
          },
          "quote_verified": {
            "type": "boolean"
          },
          "share_allowed": {
            "const": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status",
        "permitted_fragment_ids",
        "excluded_reasons"
      ],
      "properties": {
        "target": {
          "enum": [
            "manual_chatgpt",
            "approved_ai_host"
          ]
        },
        "status": {
          "enum": [
            "prepared_not_sent",
            "submitted_by_user",
            "sent_by_approved_host"
          ]
        },
        "permitted_fragment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "template_revision",
          "text"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          },
          "template_revision": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_schema_checked",
        "citations_checked",
        "status"
      ],
      "properties": {
        "local_schema_checked": {
          "type": "boolean"
        },
        "citations_checked": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "example_only",
            "unverified",
            "reviewed"
          ]
        }
      }
    },
    "normalized_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
