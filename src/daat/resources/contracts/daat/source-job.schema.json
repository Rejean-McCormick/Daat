{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/daat/source-job.local.schema.json",
  "title": "DaaT source job — local proposed interface, not owner contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "sources"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8
    },
    "max_context_chars": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 5000000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform_id",
          "external_id",
          "revision",
          "content_kind",
          "rights"
        ],
        "properties": {
          "platform_id": {
            "type": "string",
            "minLength": 1
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "content_kind": {
            "enum": [
              "reference_only",
              "abstract",
              "excerpt",
              "full_text_authorized",
              "dataset",
              "structured_record",
              "media_derivative"
            ]
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "acquired_via": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "git_commit": {
            "type": "string"
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "copy": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "retain": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "transform": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "ai_disclosure": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string"
              },
              "evidence_ref": {
                "type": "string"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "attestation": {
                "enum": [
                  "unverified",
                  "operator_asserted",
                  "host_verified"
                ]
              },
              "classification": {
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              "tenant": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "revoked": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "content_kind": {
                  "const": "reference_only"
                }
              },
              "required": [
                "content_kind"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "required": [
                      "text"
                    ]
                  }
                ]
              }
            },
            "else": {
              "oneOf": [
                {
                  "required": [
                    "path"
                  ],
                  "not": {
                    "required": [
                      "text"
                    ]
                  }
                },
                {
                  "required": [
                    "text"
                  ],
                  "not": {
                    "required": [
                      "path"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
